    <!-- Interactive Search and Filter Script -->
    <script>
        function filterAlumni() {
            let input = document.getElementById('searchInput').value.toLowerCase();
            let batch = document.getElementById('batchFilter').value;
            let cards = document.getElementsByClassName('alumni-card');
            let visibleCount = 0;

            for (let i = 0; i < cards.length; i++) {
                let name = cards[i].getAttribute('data-name').toLowerCase();
                let company = cards[i].getAttribute('data-company').toLowerCase();
                let cardBatch = cards[i].getAttribute('data-batch');

                let matchesSearch = name.includes(input) || company.includes(input);
                let matchesBatch = batch === "" || cardBatch === batch;

                if (matchesSearch && matchesBatch) {
                    cards[i].style.display = "flex";
                    visibleCount++;
                } else {
                    cards[i].style.display = "none";
                }
            }
            document.getElementById('resultCount').innerText = `Showing ${visibleCount} members`;
        }

        function connectAlert(name) {
            alert(`Connection request sent to ${name}! They will be notified.`);
        }
    </script>
